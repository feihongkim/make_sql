; abledb 스케줄러 systemd 유닛 (user 단위)
;
; 스케줄러는 다른 프로세스를 감시하는 쪽인데 정작 자신은 nohup 으로만 떠 있어,
; 죽으면 아무도 다시 띄우지 않았다. 이 유닛으로 감시 대상에 넣는다.
;
; ── 왜 system 이 아니라 user 단위인가 ──────────────────────────────────────
; 이 호스트의 sudo 는 비밀번호를 요구한다. /etc/systemd/system 에 두면
; systemctl 제어에 매번 sudo 가 필요해, 비대화형 에이전트가 스케줄러를
; 재시작할 수 없게 된다. user 단위는 sudo 없이 제어된다.
;
; ── 설치 ──────────────────────────────────────────────────────────────────
;   ./abledb_Hope scheduler stop            # 수동 인스턴스를 먼저 내린다
;   mkdir -p ~/.config/systemd/user
;   cp scripts/abledb-scheduler.service ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now abledb-scheduler
;
; ⚠️ 부팅 시 자동 기동과 로그아웃 후 유지에는 linger 가 필요하다. 이것만 sudo 를 쓴다.
;   sudo loginctl enable-linger feihong
;   (켜지 않으면 SSH 세션이 끊길 때 스케줄러도 함께 내려간다)
;
; ── 운영 (전부 sudo 불필요) ───────────────────────────────────────────────
;   systemctl --user status abledb-scheduler
;   systemctl --user restart abledb-scheduler      # 재빌드 후 반영
;   systemctl --user stop abledb-scheduler
;   journalctl --user -u abledb-scheduler -f
;
; ⚠️ 등록 후에는 `./abledb_Hope scheduler stop` 이 무력하다. SIGTERM 을 보내도
;    Restart=always 로 10초 뒤 되살아난다. 멈추려면 systemctl --user stop 을 쓴다.

[Unit]
Description=abledb scheduler (MakeSQL orchestrator)
Documentation=file:///home/feihong/code/MakeSQL/README.md

; 재시작 폭주 방지: 5분 동안 5회를 넘기면 멈춘다.
; (StartLimit* 은 [Service] 가 아니라 [Unit] 섹션 키다)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/feihong/code/MakeSQL

; config.yaml 을 WorkingDirectory 에서 읽는다.
; docker / ssh / go 를 쓰므로 PATH 를 명시한다 (systemd 기본 PATH 는 좁다).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin

; 로그 디렉토리가 없으면 StandardOutput=append: 가 실패해 기동 자체가 안 된다.
ExecStartPre=/bin/mkdir -p /home/feihong/code/MakeSQL/test_logs
ExecStart=/home/feihong/code/MakeSQL/abledb_Hope scheduler

; 패닉이 복구되지 않는 경우(런타임 치명 오류 등)에도 반드시 되살린다.
Restart=always
RestartSec=10

StandardOutput=append:/home/feihong/code/MakeSQL/test_logs/scheduler_systemd.log
StandardError=append:/home/feihong/code/MakeSQL/test_logs/scheduler_systemd.log

[Install]
WantedBy=default.target
