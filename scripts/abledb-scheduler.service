; abledb 스케줄러 systemd 유닛
;
; 스케줄러는 다른 프로세스를 감시하는 쪽인데 정작 자신은 nohup 으로만 떠 있어,
; 죽으면 아무도 다시 띄우지 않았다. 이 유닛으로 감시 대상에 넣는다.
;
; 설치 (sudo 필요):
;   sudo cp scripts/abledb-scheduler.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now abledb-scheduler
;
; ⚠️ 설치 전에 수동 기동된 인스턴스를 반드시 먼저 내린다.
;    스케줄러는 PID 파일로 중복 실행을 막고 exit 1 로 끝나므로, 남아 있으면
;    systemd 가 10초마다 재시작을 반복한다.
;      ./abledb_Hope scheduler stop
;
; 상태 확인:
;   systemctl status abledb-scheduler
;   journalctl -u abledb-scheduler -f

[Unit]
Description=abledb scheduler (MakeSQL orchestrator)
Documentation=file:///home/feihong/code/MakeSQL/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=feihong
Group=feihong
WorkingDirectory=/home/feihong/code/MakeSQL

; config.yaml 을 WorkingDirectory 에서 읽는다.
; docker / ssh / go 를 쓰므로 PATH 를 명시한다 (systemd 기본 PATH 는 좁다).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin
ExecStart=/home/feihong/code/MakeSQL/abledb_Hope scheduler

; 패닉이 복구되지 않는 경우(런타임 치명 오류 등)에도 반드시 되살린다.
Restart=always
RestartSec=10

; 재시작 폭주 방지: 5분 동안 5회를 넘기면 멈추고 알림을 남긴다.
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=append:/home/feihong/code/MakeSQL/test_logs/scheduler_systemd.log
StandardError=append:/home/feihong/code/MakeSQL/test_logs/scheduler_systemd.log

[Install]
WantedBy=multi-user.target
